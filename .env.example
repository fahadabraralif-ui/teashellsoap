# First-run admin password (stored hashed in the database; change it later from Admin > Settings)
ADMIN_PASSWORD=admin123

# Postgres connection string (Neon on Vercel sets this). When empty, data is kept in ./data instead.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Where the JSON database and uploads are kept when DATABASE_URL is not set (default: ./data)
# DATA_DIR=/var/teashell-data
