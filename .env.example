# First-run admin password (stored hashed in the database; change it later from Admin > Settings)
ADMIN_PASSWORD=admin123

# MongoDB connection string. Required on Vercel. When empty, data is kept in ./data instead.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=teashell

# Where the JSON database and uploads are kept when MONGODB_URI is not set (default: ./data)
# DATA_DIR=/var/teashell-data
